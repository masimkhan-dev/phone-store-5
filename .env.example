# Copy to .env and fill in. Never commit the real file.

# Supabase project (Settings > API). Use a separate project for staging and production.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Full database access. Server only: it is never sent to the browser. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, no trailing slash. Used for canonical URLs, the sitemap and email links.
SITE_URL=http://localhost:5173

# Any long random string (for example: openssl rand -hex 32). Salts the hashes used for
# rate limiting and anonymous visit counting. Changing it resets both.
HASH_SALT=

# Enquiry alert emails, sent through Resend (https://resend.com). Leave empty to disable:
# enquiries are still saved and shown in the dashboard, and the server logs that no email was sent.
RESEND_API_KEY=
EMAIL_FROM=
